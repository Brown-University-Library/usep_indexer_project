## DJANGO SETTINGS --------------------------------------------------

## Django core/security settings ------------------------------------
SECRET_KEY="replace_with_a_long_random_value"
DEBUG_JSON="true"
ADMINS_JSON='[["Example Admin", "admin@example.org"]]'
ALLOWED_HOSTS_JSON='["127.0.0.1", "localhost"]'
CSRF_TRUSTED_ORIGINS_JSON='[]'
SESSION_COOKIE_SECURE_JSON="false"

## Django path/other settings ---------------------------------------
STATIC_URL="/static/"
STATIC_ROOT="../static_root"
SERVER_EMAIL="donotreply@example.org"
EMAIL_HOST="localhost"
EMAIL_PORT="1026"
LOG_PATH="../logs/usep_indexer.log"
LOG_LEVEL="DEBUG"
CACHES_JSON='{"default": {"BACKEND": "django.core.cache.backends.filebased.FileBasedCache", "LOCATION": "../cache_dir", "TIMEOUT": 0}}'

## APP SETTINGS -----------------------------------------------------

## app_listener settings -------------------------------------------
BASIC_AUTH_USERNAME="replace_me"
BASIC_AUTH_PASSWORD="replace_me"
LEGIT_IPS_JSON='["127.0.0.1"]'
README_URL="https://github.com/Brown-University-Library/usep_indexer_project"

## app_processor settings ------------------------------------------
USEP_DATA_GIT_CLONED_DIR_PATH="/path/to/usep_data_clone"
TEMP_UNIFIED_INSCRIPTIONS_DIR_PATH="/path/to/temp_unified_inscriptions_dir"
WEBSERVED_DATA_DIR_PATH="/path/to/webserved/usep_data"
SPOOL_ROOT_PATH="/path/to/durable/usep_indexer_spool"
## Total attempts, including the first attempt. Two allows one later retry.
SPOOL_MAX_ATTEMPTS="2"
SPOOL_BATCH_SIZE="100"
SPOOL_COMPLETED_RETENTION_DAYS="30"
SPOOL_HEALTH_MAX_AGE_SECONDS="300"

## app_data_team_email settings ------------------------------------
## Optional data-team report when queued work reaches its attempt limit with recognized inscription errors.
## Earlier retry attempts send no email. Only technical failures send a separate email to Django ADMINS.
## Empty list disables it. Example: '["editor@example.org", "reviewer@example.org"]'
USEP_DATA_TEAM_EMAILS_JSON='[]'
## Optional CC addresses, including administrators who want reports. The primary list must still be nonempty.
USEP_DATA_TEAM_CC_EMAILS_JSON='[]'
## Use a short label such as Development or Production to distinguish reports.
USEP_DATA_TEAM_EMAIL_LABEL="Development"

## app_indexer settings --------------------------------------------
SOLR_URL="http://127.0.0.1:8983/solr/us_epigraphy"
SOLR_XSL_PATH="/path/to/webserved/usep_data/resources/xsl/USEp_to_Solr.xsl"
TRANSCRIPTION_PARSER_XSL_PATH="/path/to/webserved/usep_data/resources/xsl/transcription_index_val.xsl"
SOLR_INDEX_BATCH_SIZE="100"
SOLR_COMMIT_WITHIN_MS="500"
SOLR_TIMEOUT_SECONDS="30"
